{
  "directories": {
    "output": "release"
  },
  "electronLanguages": ["en-US", "zh-CN"],
  "beforePack": "./scripts/packaging/electron-builder-hooks.cjs",
  "afterPack": "./scripts/packaging/electron-builder-hooks.cjs",
  "artifactBuildCompleted": "./scripts/packaging/electron-builder-hooks.cjs",
  "afterAllArtifactBuild": "./scripts/packaging/electron-builder-hooks.cjs",
  "files": [
    "package.json",
    "LICENSE",
    "resources/pages/renderer-preferences.html",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": ["**/*", "!**/*.map", "!src/**"]
    },
    "!**/*.map",
    "!**/*.pdb",
    "!**/*.d.ts",
    "!**/*.d.cts",
    "!**/*.d.mts",
    "!**/README.md",
    "!**/README",
    "!**/readme.md",
    "!**/CHANGELOG.md",
    "!**/CHANGELOG",
    "!**/HISTORY.md",
    "!**/.eslintrc*",
    "!**/.prettierrc*",
    "!**/tsconfig.json",
    "!**/tsconfig.*.json",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/tests/**",
    "!**/test/**",
    "!**/__tests__/**",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/better-sqlite3/binding.gyp",
    "!node_modules/node-pty/prebuilds/win32-!(${arch})/**/*",
    "!node_modules/node-pty/third_party/**/*",
    "!node_modules/npm/docs/**",
    "!node_modules/npm/man/**"
  ],
  "extraResources": [
    {
      "from": "resources/icons/tray",
      "to": "tray",
      "filter": ["**/*"]
    },
    {
      "from": "resources/package-manager-config",
      "to": "package-manager-config",
      "filter": ["**/*"]
    },
    {
      "from": "build/browser-extension/chrome-extension",
      "to": "browser-extension/chrome-extension",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": ["dmg"],
    "icon": "resources/icons/mac/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "extendInfo": {
      "CFBundleIconName": "icon"
    },
    "extraResources": [
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*",
          "!gateway.asar",
          "!dist/extensions/drawio/assets/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**",
          "docs/**/*",
          "skills/**/*",
          "**/*.md",
          "!dist/worker-artifacts{,/**}",
          "node-runtime/**/*"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current/dist/extensions/drawio/assets",
        "to": "cfmind/dist/extensions/drawio/assets",
        "filter": ["**/*"]
      }
    ]
  },
  "dmg": {
    "sign": false
  },
  "afterSign": "scripts/packaging/notarize.js",
  "win": {
    "target": ["nsis"],
    "icon": "resources/icons/win/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "extraResources": [
      {
        "from": "build/browser-extension/native-host",
        "to": "browser-extension/native-host",
        "filter": ["justdo-browser-extension-native-host-v2.exe"]
      },
      {
        "from": "build/tar/win-resources.tar.zst",
        "to": "win-resources.tar.zst"
      },
      {
        "from": "build/tar/win-resources-metadata.json",
        "to": "win-resources-metadata.json"
      },
      {
        "from": "scripts/packaging/unpack-cfmind.cjs",
        "to": "unpack-cfmind.cjs"
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "resources/icons/png",
    "category": "Utility",
    "extraResources": [
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*",
          "!gateway.asar",
          "!dist/extensions/drawio/assets/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**",
          "docs/**/*",
          "skills/**/*",
          "**/*.md",
          "!dist/worker-artifacts{,/**}",
          "node-runtime/**/*"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current/dist/extensions/drawio/assets",
        "to": "cfmind/dist/extensions/drawio/assets",
        "filter": ["**/*"]
      }
    ],
    "desktop": {
      "entry": {
        "Comment": "AI-assisted coding and productivity tool",
        "Terminal": "false"
      }
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "scripts/packaging/nsis-installer.nsh",
    "differentialPackage": false,
    "preCompressedFileExtensions": [".zst"]
  },
  "asarUnpack": [
    "node_modules/better-sqlite3/build/Release/*.node",
    "node_modules/node-pty/build/Release/**/*",
    "node_modules/node-pty/prebuilds/**/*"
  ],
  "asar": true
}
