{
  "directories": {
    "output": "release"
  },
  "beforePack": "./scripts/electron-builder-hooks.cjs",
  "afterPack": "./scripts/electron-builder-hooks.cjs",
  "files": [
    "package.json",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": ["**/*"]
    },
    "!**/*.map",
    "!**/*.d.ts",
    "!**/*.d.cts",
    "!**/*.d.mts",
    "!**/README.md",
    "!**/README",
    "!**/readme.md",
    "!**/CHANGELOG.md",
    "!**/CHANGELOG",
    "!**/HISTORY.md",
    "!**/LICENSE",
    "!**/LICENSE.md",
    "!**/LICENSE.txt",
    "!**/.eslintrc*",
    "!**/.prettierrc*",
    "!**/tsconfig.json",
    "!**/tsconfig.*.json",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/tests/**",
    "!**/test/**",
    "!**/__tests__/**"
  ],
  "extraResources": [
    {
      "from": "resources/tray",
      "to": "tray",
      "filter": ["**/*"]
    },
    {
      "from": "resources/dependency-config",
      "to": "dependency-config",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": ["dmg"],
    "icon": "resources/icons/mac/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "extendInfo": {
      "CFBundleIconName": "icon"
    },
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      }
    ]
  },
  "dmg": {
    "sign": false
  },
  "afterSign": "scripts/notarize.js",
  "win": {
    "target": ["nsis"],
    "icon": "resources/icons/win/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "extraResources": [
      {
        "from": "build-tar/win-resources.tar",
        "to": "win-resources.tar"
      },
      {
        "from": "scripts/unpack-cfmind.cjs",
        "to": "unpack-cfmind.cjs"
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "resources/icons/png",
    "category": "Utility",
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      }
    ],
    "desktop": {
      "entry": {
        "Comment": "AI-assisted coding and productivity tool",
        "Terminal": "false"
      }
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": true,
    "include": "scripts/nsis-installer.nsh"
  },
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/npm/**"
  ],
  "asar": true
}
