{
  "version": 3,
  "openclawVersion": "2026.8.2",
  "runtimeExtensionsPath": "vendor/openclaw-runtime/{platform}/dist/extensions",
  "description": "Version-scoped allowlist for OpenClaw-managed bundled extensions. Every upstream extension must be declared in keep or remove; unknown extensions fail pruning for review. JustDo-owned custom extensions are protected separately.",
  "keep": [
    "anthropic",
    "active-memory",
    "admin-http-rpc",
    "browser",
    "document-extract",
    "file-transfer",
    "llm-task",
    "logbook",
    "memory-core",
    "memory-wiki",
    "oc-path",
    "openai",
    "policy",
    "web-readability",
    "workboard"
  ],
  "remove": [
    {
      "category": "unused-remote-and-device-integrations",
      "reason": "External messaging, device, node and remote-control integrations are not part of the JustDo desktop runtime.",
      "extensions": [
        "a2a",
        "beam",
        "bonjour",
        "canvas",
        "crabbox",
        "cua-computer",
        "device-pair",
        "geolocation",
        "imap",
        "linux-node",
        "onepassword",
        "reef",
        "telegram",
        "vault",
        "webhooks"
      ]
    },
    {
      "category": "migration-tools",
      "reason": "One-time third-party import helpers are not required for normal JustDo startup or the native session SQLite migration.",
      "extensions": ["migrate-claude", "migrate-hermes"]
    },
    {
      "category": "optional-speech-and-media",
      "reason": "Speech, media, image and video providers are not enabled in the default desktop runtime.",
      "extensions": [
        "alibaba",
        "azure-speech",
        "deepgram",
        "elevenlabs",
        "fal",
        "image-generation-core",
        "microsoft",
        "runway",
        "senseaudio",
        "talk-voice",
        "tts-local-cli"
      ]
    },
    {
      "category": "unused-model-providers",
      "reason": "Model providers not kept in the default slim runtime. Move an extension to keep only when the app owns its configuration path.",
      "extensions": [
        "clawrouter",
        "copilot-proxy",
        "github-copilot",
        "google",
        "huggingface",
        "litellm",
        "lmstudio",
        "microsoft-foundry",
        "minimax",
        "nvidia",
        "ollama",
        "opencode-go",
        "openrouter",
        "sglang",
        "together",
        "vllm",
        "xai"
      ]
    }
  ]
}
