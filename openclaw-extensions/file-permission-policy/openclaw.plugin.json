{
  "id": "file-permission-policy",
  "name": "File Permission Policy",
  "description": "Policy for file and scheduled-task mutation tools.",
  "contracts": {
    "trustedToolPolicies": ["core-file-mutation"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["ask", "auto", "full"]
      },
      "fullAgentIds": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    }
  }
}
