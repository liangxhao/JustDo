{
  "id": "ask-user-question",
  "name": "AskUserQuestion",
  "description": "Rich structured questions for the JustDo desktop application.",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["tool"]
  },
  "contracts": {
    "tools": ["AskUserQuestion"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timeoutMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1440,
        "default": 10,
        "description": "Wait time for questions with timeoutEnabled"
      }
    }
  }
}
