POSTGRES_DB=litellm
UI_USERNAME=admin
UI_PASSWORD=
LITELLM_DEPLOYMENT_NAME=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://litellm:replace-with-url-encoded-password@db:5432/litellm

# Server-side administrator secret. Never put this value in the desktop app.
LITELLM_MASTER_KEY=replace-with-a-random-litellm-master-key
# Stable database encryption secret. On migration,
# preserve the previous LITELLM_SALT_KEY (or previous master key if no salt was set).
LITELLM_SALT_KEY=replace-with-a-stable-database-encryption-secret
REDIS_PASSWORD=replace-with-a-random-redis-password

# Keep 16 in normal operation. During the one-time legacy-key migration only,
# set this to the exact length of the old short key, then restore 16 and restart.
MINIMUM_CUSTOM_KEY_LENGTH=16

# Short-lived JWT issuer used by JWT-enabled clients. The JWKS endpoint
# must publish asymmetric public keys and each token must include kid, iss,
# aud, sub, iat, exp, and jti. Five minutes is the recommended default.
LITELLM_JWT_ISSUER=https://login.example.com
LITELLM_JWT_AUDIENCE=model-service
LITELLM_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
LITELLM_JWT_ALGORITHMS=RS256
LITELLM_JWT_MAX_LIFETIME_SECONDS=300
# Match the issuer policy explicitly: 900 or 10800 is also supported (maximum 10800).
LITELLM_JWT_CLOCK_SKEW_SECONDS=30
# Initialization creates this Team once; configure its models and limits in the UI. Empty disables enrollment.
LITELLM_DEFAULT_TEAM_ID=standard

LITELLM_PORT=9108
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.99.1
LITELLM_HOOKS=activity
MAX_STRING_LENGTH_PROMPT_IN_DB=100000
# asyncpg URL: omit Prisma-only query parameters, preserve the database/schema.
LITELLM_ACTIVITY_DATABASE_URL=postgresql://litellm:replace-with-url-encoded-password@db:5432/litellm
# Optional old-client activity compatibility. SHA256("customer/activity/v1:" + old key).
# Leave both empty to reject legacy activity; model Virtual Key expiry is separate.
LITELLM_ACTIVITY_TOKEN=
# Absolute UTC deadline, no later than the legacy model key expiration.
LITELLM_ACTIVITY_LEGACY_EXPIRES_AT=
