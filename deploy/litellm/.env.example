POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://litellm:replace-with-url-encoded-password@db:5432/litellm

# Server-side administrator secret. Never put this value in the desktop app.
LITELLM_MASTER_KEY=replace-with-a-random-litellm-master-key

# Keep 16 in normal operation. During the one-time legacy-key migration only,
# set this to the exact length of the old short key, then restore 16 and restart.
MINIMUM_CUSTOM_KEY_LENGTH=16

# Short-lived JWT issuer used by upgraded JustDo clients. The JWKS endpoint
# must publish asymmetric public keys and each token must include kid, iss,
# aud, sub, iat, exp, and jti. Keep the maximum lifetime at five minutes.
JUSTDO_JWT_ISSUER=https://login.example.com
JUSTDO_JWT_AUDIENCE=justdo-litellm
JUSTDO_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
JUSTDO_JWT_ALGORITHMS=RS256
JUSTDO_JWT_MAX_LIFETIME_SECONDS=300
JUSTDO_JWT_CLOCK_SKEW_SECONDS=30

LITELLM_PORT=9108
