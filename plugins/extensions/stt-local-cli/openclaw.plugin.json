{
  "id": "stt-local-cli",
  "name": "stt-local-cli",
  "description": "Transcribe audio attachments with the selected local or configured online model.",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true,
    "onCapabilities": ["tool"]
  },
  "contracts": {
    "tools": ["transcribe_audio"]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": true,
      "paths": [{ "path": "apiKey", "expected": "string", "ownerKind": "capability" }]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": { "type": "string", "enum": ["local", "online"] },
      "baseUrl": { "type": "string" },
      "model": { "type": "string" },
      "apiKey": { "type": ["string", "object"] },
      "command": {
        "type": "string"
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "modelId": {
        "type": "string"
      },
      "language": {
        "type": "string",
        "enum": ["auto", "zh", "en", "ja", "ko", "yue"]
      }
    }
  }
}
