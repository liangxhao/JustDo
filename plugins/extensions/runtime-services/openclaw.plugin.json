{
  "id": "runtime-services",
  "name": "Runtime Services",
  "description": "Provides runtime progress, history detail, and embedding capabilities.",
  "providers": [
    "builtin_models"
  ],
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook",
      "tool"
    ]
  },
  "contracts": {
    "gatewayMethodDispatch": [
      "authenticated-request"
    ],
    "embeddingProviders": [
      "runtime-services"
    ],
    "trustedToolPolicies": [
      "external-mcp",
      "execution-admission"
    ],
    "tools": [
      "external_mcp"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": true,
      "paths": [
        {
          "path": "replySpeech.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "replySpeech": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseUrl",
              "model",
              "speakerVoice"
            ],
            "properties": {
              "baseUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "speakerVoice": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "apiKey": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 16384
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "env",
                          "file",
                          "exec",
                          "store"
                        ]
                      },
                      "provider": {
                        "type": "string",
                        "minLength": 1
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
