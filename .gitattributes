# Force LF line endings for shell scripts (required for bash on all platforms)
*.sh text eol=lf

# Patch modules serialize function source into runtime bundles. Keep their source
# stable so Windows autocrlf settings cannot change generated runtime artifacts.
scripts/patches/** text eol=lf

# Chrome Assistant includes a checksummed upstream baseline and local overlays.
plugins/chrome-extensions/chrome-assistant/** text eol=lf
plugins/chrome-extensions/chrome-assistant/**/*.png binary

# Lit's generated template literals contain meaningful trailing whitespace.
plugins/chrome-extensions/chrome-assistant/conversation-overlay/modules/sidepanel-rich-content.js whitespace=-blank-at-eol
